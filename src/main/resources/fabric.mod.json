{
	"schemaVersion": 1,
	"id": "stickytoggle",
	"version": "${version}",
	"name": "StickyToggle",
	"description": "Lets server ops toggle how slime and honey blocks physically affect players. Mobs, items and mechanics stay vanilla.",
	"authors": ["steelaspect"],
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": ["com.steelaspect.stickytoggle.StickyToggle"],
		"client": ["com.steelaspect.stickytoggle.client.StickyToggleClient"]
	},
	"mixins": ["stickytoggle.mixins.json"],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}
