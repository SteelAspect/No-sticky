{
	"schemaVersion": 1,
	"id": "stickytoggle",
	"version": "${version}",
	"name": "StickyToggle",
	"description": "Lets each player turn off how slime, honey, soul sand, ice, cobwebs, powder snow, berry bushes, water currents and bubble columns move them. Mobs, items and mechanics stay vanilla.",
	"authors": ["steelaspect"],
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": ["com.steelaspect.stickytoggle.StickyToggle"],
		"client": ["com.steelaspect.stickytoggle.client.StickyToggleClient"],
		"modmenu": ["com.steelaspect.stickytoggle.client.ModMenuIntegration"]
	},
	"mixins": ["stickytoggle.mixins.json"],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"malilib": ">=${malilib_version}",
		"modmenu": "*"
	}
}
